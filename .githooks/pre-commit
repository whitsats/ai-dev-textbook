#!/bin/sh
# 提交前校验（pre-commit）
#
# 目的：让「体例 / 术语 / 术语日志对账 / 交叉引用 / 链接登记 / 素材溯源 / 跨章重复 / 篇幅实测引用」
#       这些检查不可能被漏跑——有错误就拦下提交。
#       （最后一项的教训：5.3 的台账指向了 `STYLE` 8.7 里不存在的「第十七个实测」，
#        而这类引用不产生任何数字，前三关一个都不会响。）
#
# 规则：
#   0. 先跑两个工具的自检夹具（--self-test），工具坏了就没必要往下走。
#   1. 每次都跑 tools/lint_book.py（纯本地、秒级）。
#   2. 默认只离线解析链接清单；只有 REFERENCES.md 被改动时才联网全量校验
#      （避免每次提交都发几十个网络请求）。
#   3. 镜像/紧急情况可临时跳过：SKIP_BOOK_CHECKS=1 git commit ...
#      但 CI 仍会跑同样检查（见 .github/workflows/book-checks.yml）。
#
# 安装：python tools/install_hooks.py

set -u

root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 0

if [ "${SKIP_BOOK_CHECKS:-0}" = "1" ]; then
    echo "[pre-commit] ⚠️  已按 SKIP_BOOK_CHECKS=1 跳过检查（CI 仍会拦）"
    exit 0
fi

PY=$(command -v python || command -v python3 || true)
if [ -z "$PY" ]; then
    echo "[pre-commit] ✖ 找不到 python，无法校验。装好 Python 或设 SKIP_BOOK_CHECKS=1" >&2
    exit 1
fi

# 保证中文输出在 Windows 控制台不乱码
PYTHONIOENCODING=utf-8
export PYTHONIOENCODING

if [ ! -f tools/lint_book.py ]; then
    echo "[pre-commit] ✖ 未找到 tools/lint_book.py（是否在教材仓库根目录？）" >&2
    exit 1
fi

# 工具自检。两个工具都会**静默退化**：
#   · lint_book.py 的 code_lines_of 曾把围栏行也算作内容（671 个围栏虚增 20,130 字）；
#   · audit_coverage.py 的对账靠「解析文档里的句子」，句式一变就落空成摆设。
# 两者都有夹具，而夹具不跑就等于没有，所以放在第一步。
echo "[pre-commit] 1/5 工具自检（字数口径 / 对账门 / 汇总数字）..."
if ! "$PY" tools/lint_book.py --self-test; then
    echo "" >&2
    echo "[pre-commit] ✖ 字数口径退化，提交被拦下：先修 tools/lint_book.py 的 code_lines_of。" >&2
    exit 1
fi
if ! "$PY" tools/audit_coverage.py --self-test >/dev/null; then
    echo "" >&2
    echo "[pre-commit] ✖ 对账门的夹具不过，提交被拦下：先修 tools/audit_coverage.py。" >&2
    exit 1
fi
if ! "$PY" tools/totals.py --self-test >/dev/null; then
    echo "" >&2
    echo "[pre-commit] ✖ 汇总数字生成器的夹具不过，提交被拦下：先修 tools/totals.py。" >&2
    exit 1
fi
if ! "$PY" tools/bank_index.py --self-test >/dev/null; then
    echo "" >&2
    echo "[pre-commit] ✖ 题库索引的夹具不过，提交被拦下：先修 tools/bank_index.py。" >&2
    exit 1
fi
if ! "$PY" tools/backend_index.py --self-test >/dev/null; then
    echo "" >&2
    echo "[pre-commit] ✖ 后端题库索引的夹具不过，提交被拦下：先修 tools/backend_index.py。" >&2
    exit 1
fi
if ! "$PY" tools/mobile_index.py --self-test >/dev/null; then
    echo "" >&2
    echo "[pre-commit] ✖ 移动端两份题库索引的夹具不过，提交被拦下：先修 tools/mobile_index.py。" >&2
    exit 1
fi
if ! "$PY" tools/mock_round.py --self-test >/dev/null; then
    echo "" >&2
    echo "[pre-commit] ✖ 模拟面试那四组读数的夹具不过，提交被拦下：先修 tools/mock_round.py。" >&2
    exit 1
fi

echo "[pre-commit] 2/5 正文一致性校验 ..."
if ! "$PY" tools/lint_book.py; then
    echo "" >&2
    echo "[pre-commit] ✖ 正文校验有错误，提交被拦下。" >&2
    echo "            修复后重试；仅想提交素材/脚本改动可设 SKIP_BOOK_CHECKS=1" >&2
    exit 1
fi

# 文档数字对账：PLAN.md / COVERAGE.md 里的汇总数字必须与实测一致。
# 这类数字一旦各写一遍就会漂（曾出现 PLAN 写 1.24 而实测已是 1.25），
# 漂了不影响写作，但会持续误导篇幅与优先级判断。
echo "[pre-commit] 3/5 文档数字对账（PLAN / README / COVERAGE / LEDGER 逐节表与章标题字数 / PROJECT 字数 vs 实测；另报逐节表「事前估」列的欠账）..."
if ! "$PY" tools/audit_coverage.py --check; then
    echo "[pre-commit] ✖ 文档数字与实测不一致，提交被拦下。" >&2
    echo "            修法：先改 tools/audit_coverage.py 的规划值，" >&2
    echo "            再跑 python tools/audit_coverage.py --out COVERAGE.md，最后同步 PLAN.md" >&2
    exit 1
fi
# 全书汇总数字（篇级进度 / 看板与文首 / README / COVERAGE）：它们**不该由人改**——
# 交章那一笔应当已经跑过 --sync。这一关拦的是「手改了一个格子」与「忘了跑」两种情况，
# 而它们正是「一章一笔自己跑不过门」的成因（详情见 STYLE 8.11）。
echo "[pre-commit] 3b/5 汇总数字对账（台账篇级进度 / PLAN 看板与文首 / README / COVERAGE）..."
if ! "$PY" tools/totals.py --check; then
    echo "[pre-commit] ✖ 汇总数字与单一来源不一致，提交被拦下。" >&2
    echo "            修法：python tools/totals.py --sync（它算出来写回去，不手抄）" >&2
    exit 1
fi

# 可运行树：正文里贴的代码必须真的在它声称的那棵树里（v3 手写版 / v4 框架版），
# 而且那份代码得跑得通。
# 这一关与前三关同级：它拦的是「正文看起来对、读者照着敲跑不通」这一类错——
# 这类错前三关一个都拦不住（正文里的代码风格合规、数字对账也对）。
echo "[pre-commit] 4/5 可运行树一致性（正文代码块 ↔ zhizhou-v3/ · v4/ · v5/）..."
if ! "$PY" tools/check_runnable.py; then
    echo "" >&2
    echo "[pre-commit] ✖ 正文与可运行树不一致（或树自身跑不通），提交被拦下。" >&2
    echo "            修法：改正文里那段，或改 zhizhou-v3/ 里那个文件——但两边必须一样。" >&2
    exit 1
fi

# 题库索引（第 10 篇的交付物）：10.4–10.6 的考点索引由脚本从题库里算出来，
# 而正文那两张表必须逐行等于算出来的值。
# 这一关拦的是「手抄的索引」——题数抄错一个、专题漏一个、归属写成别的章，
# 前面四关一个都不会响（正文风格合规、字数对账也对）。
# 第 10 篇没有可运行树，这一关就是它的「可运行」那一层：**索引能跑、且与正文相等**。
echo "[pre-commit] 4b/5 题库索引对账（第 10 篇：专题／题数／考点数／归属）..."
if ! "$PY" tools/bank_index.py --check; then
    echo "" >&2
    echo "[pre-commit] ✖ 正文 10.4 的索引表与题库不一致，提交被拦下。" >&2
    echo "            修法：python tools/bank_index.py --offline 取真值，再改正文那张表。" >&2
    exit 1
fi
echo "[pre-commit] 4c/5 后端题库的岗位视角索引（第 10 篇：板块／处置／难度／题面关键词）..."
if ! "$PY" tools/backend_index.py --check; then
    echo "" >&2
    echo "[pre-commit] ✖ 正文 10.5 的板块表与题库不一致，提交被拦下。" >&2
    echo "            修法：python tools/backend_index.py --offline 取真值，再改正文那两张表。" >&2
    exit 1
fi
# 10.6 第一次同时面对**两份**题库，所以这一关多两组读数：**素材可用性**
# （模板答案／OCR／水印——别人的题库能不能用，先数一遍）与**两列反向索引**。
echo "[pre-commit] 4d/5 移动端两份题库的索引（第 10 篇：地形图／处置／素材可用性／两列反向索引）..."
if ! "$PY" tools/mobile_index.py --check; then
    echo "" >&2
    echo "[pre-commit] ✖ 正文 10.6 的表与两份题库不一致，提交被拦下。" >&2
    echo "            修法：python tools/mobile_index.py --offline 取真值，再改正文那两张地形图表。" >&2
    exit 1
fi
# 10.7 的读数没有外部来源（它的剧本就写在脚本里），所以这一关守的是另一件事：
# **这一章自己定的口径（时间预算、评分维度、失败模式）与正文逐处相等**。
echo "[pre-commit] 4e/5 模拟面试与复盘（第 10 篇：时间账／追问穿透／评分／失败模式）..."
if ! "$PY" tools/mock_round.py --check; then
    echo "" >&2
    echo "[pre-commit] ✖ 正文 10.7 的四张表与剧本不一致，提交被拦下。" >&2
    echo "            修法：python tools/mock_round.py --offline 取真值，再改正文那四张表。" >&2
    exit 1
fi

staged=$(git diff --cached --name-only)

if printf '%s\n' "$staged" | grep -q 'REFERENCES\.md'; then
    echo "[pre-commit] 5/5 REFERENCES.md 有改动 → 联网校验全部链接 ..."
    if ! "$PY" tools/check_refs.py --only-broken; then
        echo "[pre-commit] ✖ 存在失效链接，提交被拦下：先修 REFERENCES.md，再同步受影响章节。" >&2
        exit 1
    fi
else
        echo "[pre-commit] 5/5 链接清单自检（离线）..."
    if ! "$PY" tools/check_refs.py --offline >/dev/null; then
        echo "[pre-commit] ✖ 链接清单解析失败，提交被拦下。" >&2
        exit 1
    fi
fi

echo "[pre-commit] ✔ 通过"
