# ---------------------------------------------------------------
# 原始资料：约 295MB（含单个 129MB 的 PDF），不适合纳入 git
# 如需恢复：原件仍完整保留在本目录，未做任何删改
# 如需重建素材库：python tools/extract_sources.py
# ---------------------------------------------------------------
raw/

# 密钥：任何情况下都不进仓库（案例参考实现用 .env 读，见 zhizhou-v3/.env.example）
.env
.env.*
!.env.example

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp

# Python
__pycache__/
*.pyc
.venv/
venv/

# 构建产物
build/
dist/
*.pdf
*.epub
!raw/**

# 教材站点（GitHub Pages）的拼装与构建产物：
# 仓库里只存一份正文，站点是它的产物（见 tools/build_site.py 顶部注释）。
site-src/
site-out/
