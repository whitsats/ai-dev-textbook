# 复制成 .env，填上真实值，然后：set -a; source .env; set +a
#
# 约定（与 3.2 的「密钥只从环境变量读」一致）：
#   · 仓库里永远不出现真实密钥；.env 已在 .gitignore 里
#   · 代码模块级导入不发请求，所以「忘了设」会在启动时立刻报错，而不是第一次调用时

# 方言：openai（OpenAI 兼容，覆盖多数国内外服务商与本地推理）｜ anthropic
LLM_PROVIDER=openai

# 任何 OpenAI 兼容端点都可以：`.../v1` 结尾，客户端自己拼 /chat/completions
LLM_BASE_URL=https://api.agnes-ai.cn/v1
LLM_MODEL=agnes-2.5-flash

# 密钥：只写在这里，不要写进任何 py/md 文件
LLM_API_KEY=sk-在这里填你自己的

# 单次请求超时（秒）与重试上限。默认 8s/2 次是第 3.2 节的示例值；
# 真实服务商生成 1,000 词元常常超过 8 秒，所以线上把它调大。
LLM_TIMEOUT=30
LLM_MAX_ATTEMPTS=2
LLM_MAX_TOKENS=1024

# 开发环境才挂载 /api/v1/llm/_budget 诊断端点
APP_ENV=dev
